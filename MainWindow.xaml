<Window x:Class="Noise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Noise"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        mc:Ignorable="d"
        Title="Noise" ShowInTaskbar="False" WindowStyle="None" ResizeMode="NoResize" Topmost="True" Background="Transparent" AllowsTransparency="True" Loaded="Window_Loaded" WindowState="Maximized">
    <Grid>
        <Image x:Name="tvOnSprite" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="310" Width="232" Source="/Assets/Sprites/tv_on.gif" gif:AnimationBehavior.SourceUri="/Assets/Sprites/tv_on.gif" Opacity="0"/>
        <Image x:Name="tvOffSprite" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="310" Width="232" Source="/Assets/Sprites/tv_off.png" Opacity="0"/>
        <Image x:Name="emergeSprite" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="310" Width="232" Source="/Assets/Sprites/emerge.gif" gif:AnimationBehavior.SourceUri="/Assets/Sprites/emerge.gif" gif:AnimationBehavior.RepeatBehavior="1x" gif:AnimationBehavior.AutoStart="False" Opacity="0"/>

        <Image x:Name="noiseCursor" HorizontalAlignment="Left" VerticalAlignment="Top" Height="32" Width="32" Source="/Assets/Sprites/pausecursor.png" gif:AnimationBehavior.SourceUri="/Assets/Sprites/cursor.gif" Opacity="0"/>

        <Popup StaysOpen="True" AllowsTransparency="True" Placement="Absolute" IsOpen="True">
            <Image x:Name="fireAlarmSprite" Height="59" Width="40" Source="/Assets/Sprites/firealarm.png" MouseLeftButtonDown="fireAlarmSprite_MouseDown"/>
        </Popup>

        <Image x:Name="jumpscareGif" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" gif:AnimationBehavior.SourceUri="/Assets/Sprites/jumpscare.gif" gif:AnimationBehavior.AutoStart="False"/>
        <Image x:Name="fireAlarmGif" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" gif:AnimationBehavior.SourceUri="/Assets/Sprites/firealarm.gif" gif:AnimationBehavior.AutoStart="False"/>
    </Grid>
</Window>